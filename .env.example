# Docker Compose overrides these to service hostnames (postgres/redis/minio).
# Local `go run` uses the localhost URLs below.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://probot:probot@localhost:5433/probot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Grok / xAI
GROK_API_KEY=
GROK_MODEL=grok-3

# Gemini / Google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Image generation (OpenAI images or compatible)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# Platform credentials (optional for local smoke)
TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=probot
S3_SECRET_KEY=probotsecret
S3_BUCKET=probot
S3_USE_SSL=false

# Short links (optional v1.1)
PUBLIC_BASE_URL=http://localhost:8080
